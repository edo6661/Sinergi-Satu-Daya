<file path="src/i18n.ts">
import i18n from "i18next";
import { initReactI18next } from "react-i18next";

const savedLanguage = localStorage.getItem("app-language") || "id";

i18n.use(initReactI18next).init({
  resources: {},
  lng: savedLanguage,
  fallbackLng: "id",
  interpolation: { escapeValue: false },
});

i18n.on("languageChanged", (lng) => {
  document.documentElement.lang = lng;
  localStorage.setItem("app-language", lng);
});

export default i18n;
</file>

<file path="src/index.css">
/* src/index.css */
@import "tailwindcss";
@plugin "@tailwindcss/typography";

@theme {
  /* Tipografi yang lebih elegan */
  --font-sans: "Montserrat", system-ui, sans-serif;
  --font-heading: "Orbitron", var(--font-sans);

  /* Palet Warna Premium (Deep Industrial) */
  --color-surface-light: #f8fafc;
  --color-surface-white: #ffffff;
  --color-surface-dark: #0f172a; /* Slate 900 */
  --color-surface-darker: #020617; /* Slate 950 */
  --color-surface-darkest: #010413; /* Deep Midnight */

  --color-content-main: #0f172a;
  --color-content-muted: #64748b;
  --color-content-light: #cbd5e1;
  --color-content-inverse: #f8fafc;

  /* Brand Colors - Electric Gold & Deep Navy */
  --color-primary: #1e293b;
  --color-primary-hover: #334155;

  --color-accent: #f59e0b; /* Amber 500 */
  --color-accent-hover: #fbbf24; /* Amber 400 */
  --color-electric: #0ea5e9; /* Sky 500 - Untuk aksen tech */

  --color-success: #10b981;
  --color-success-hover: #059669;

  --color-border-light: #e2e8f0;
  --color-border-strong: rgba(255, 255, 255, 0.1);
}

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-surface-light);
    color: var(--color-content-main);
    font-family: var(--font-sans);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .glow-accent {
    box-shadow:
      0 0 24px rgba(245, 158, 11, 0.3),
      inset 0 0 12px rgba(245, 158, 11, 0.1);
  }

  .glow-accent-hover:hover {
    box-shadow:
      0 0 32px rgba(245, 158, 11, 0.5),
      inset 0 0 16px rgba(245, 158, 11, 0.2);
  }

  /* Glassmorphism yang lebih premium */
  .glass-dark {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
  }

  .glass-card {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
  }
}
.text-gradient-accent {
  background: linear-gradient(
    135deg,
    var(--color-accent) 0%,
    #ffedd5 50%,
    #fb923c 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-size: 200% auto;
  animation: shine 4s linear infinite;
}

@keyframes shine {
  to {
    background-position: 200% center;
  }
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}

@layer utilities {
  /* Efek kilap premium untuk tombol dan card */
  .animate-shimmer {
    position: relative;
    overflow: hidden;
  }
  .animate-shimmer::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    transform: translateX(-100%);
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, 0.05) 20%,
      rgba(255, 255, 255, 0.2) 60%,
      rgba(255, 255, 255, 0) 100%
    );
    animation: shimmer 3s infinite;
    pointer-events: none;
  }

  @keyframes ripple {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
    }
    70% {
      box-shadow: 0 0 0 20px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }
  .animate-ripple {
    animation: ripple 2s infinite;
  }

  /* Custom Scrollbar Premium agar menyatu dengan tema */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--color-surface-darkest);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--color-primary-hover);
    border-radius: 8px;
    border: 2px solid var(--color-surface-darkest); /* Efek padding */
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-content-muted);
  }
}
