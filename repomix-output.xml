  --color-surface-light: var(--color-slate-50);
  --color-surface-white: var(--color-white);
  --color-surface-dark: var(--color-slate-800);
  --color-surface-darker: var(--color-slate-900);
  --color-surface-darkest: var(--color-slate-950);

  --color-content-main: var(--color-slate-950);
  --color-content-muted: var(--color-slate-500);
  --color-content-light: var(--color-slate-300);
  --color-content-inverse: var(--color-slate-50);

  --color-primary: var(--color-blue-950);
  --color-primary-hover: var(--color-blue-900);

  --color-accent: var(--color-amber-500);
  --color-accent-hover: var(--color-amber-400);

  --color-success: var(--color-green-500);
  --color-success-hover: var(--color-green-400);

  --color-border-light: var(--color-slate-200);
  --color-border-strong: var(--color-slate-600);
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-surface-light);
  color: var(--color-content-main);
  font-family: var(--font-sans);
  overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  letter-spacing: 0.05em;
}
